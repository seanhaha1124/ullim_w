?>
<script id="sanc-split-story-script">
(function () {

    'use strict';


    /*
     * 중복 실행 방지
     */
    if (
        window.seanhahaSancRealSplitStarted
    ) {
        return;
    }


    window.seanhahaSancRealSplitStarted =
        true;


    /* ==================================================
       계산 함수
    ================================================== */

    function clamp(
        value,
        min,
        max
    ) {

        return Math.min(
            Math.max(
                value,
                min
            ),
            max
        );

    }


    function range(
        value,
        start,
        end
    ) {

        if (start === end) {
            return 0;
        }


        return clamp(
            (
                value -
                start
            ) /
            (
                end -
                start
            ),
            0,
            1
        );

    }


    function smootherStep(value) {

        value =
            clamp(
                value,
                0,
                1
            );


        return value *
            value *
            value *
            (
                value *
                (
                    value * 6 -
                    15
                ) +
                10
            );

    }


    function lerp(
        start,
        end,
        progress
    ) {

        return start +
            (
                end -
                start
            ) *
            progress;

    }


    function removeElementorMotion(element) {

        if (!element) {
            return;
        }


        element.classList.remove(
            'elementor-invisible',
            'animated',
            'fadeIn',
            'fadeInUp',
            'fadeInDown',
            'fadeInLeft',
            'fadeInRight',
            'zoomIn'
        );

    }


    /* ==================================================
       초기화
    ================================================== */

    function initSancRealSplit() {

        const stories =
            Array.from(
                document.querySelectorAll(
                    '.sanc-split-story'
                )
            );


        if (!stories.length) {
            return;
        }


        const states =
            [];


        stories.forEach(function (story) {

            const scenes =
                Array.from(
                    story.querySelectorAll(
                        '.sanc-split-scene'
                    )
                ).filter(function (scene) {

                    return (
                        scene.closest(
                            '.sanc-split-story'
                        ) === story
                    );

                });


            scenes.forEach(function (scene) {

                const stage =
                    scene.querySelector(
                        '.sanc-split-stage'
                    );


                const base =
                    scene.querySelector(
                        '.sanc-split-base'
                    );


                const cover =
                    scene.querySelector(
                        '.sanc-split-cover'
                    );


                const slogan =
                    scene.querySelector(
                        '.sanc-split-slogan'
                    );


                const description =
                    scene.querySelector(
                        '.sanc-split-description'
                    );


                const keyword =
                    scene.querySelector(
                        '.sanc-split-keyword'
                    );


                if (
                    !stage ||
                    !base ||
                    !cover ||
                    !slogan ||
                    !description ||
                    !keyword
                ) {

                    console.warn(
                        'SANC 실제 너비 분할 효과: 필요한 클래스가 빠졌습니다.',
                        scene
                    );

                    return;

                }


                [
                    slogan,
                    description,
                    keyword
                ].forEach(
                    removeElementorMotion
                );


                /*
                 * 기존 clip-path 값 제거
                 */
                base.style.setProperty(
                    'clip-path',
                    'none',
                    'important'
                );


                base.style.setProperty(
                    '-webkit-clip-path',
                    'none',
                    'important'
                );


                cover.style.setProperty(
                    'clip-path',
                    'none',
                    'important'
                );


                cover.style.setProperty(
                    '-webkit-clip-path',
                    'none',
                    'important'
                );


                /*
                 * sticky를 막는 상위 요소 보정
                 */
                let parent =
                    scene.parentElement;


                while (
                    parent &&
                    parent !== document.body
                ) {

                    const style =
                        window.getComputedStyle(
                            parent
                        );


                    if (
                        style.overflow === 'hidden' ||
                        style.overflow === 'clip' ||
                        style.overflowY === 'hidden' ||
                        style.overflowY === 'clip' ||
                        style.overflowY === 'auto' ||
                        style.overflowY === 'scroll'
                    ) {

                        parent.classList.add(
                            'sanc-split-sticky-parent'
                        );

                    }


                    parent =
                        parent.parentElement;

                }


                /*
                 * 첫 영문 제목과 핵심 글씨 중앙 정렬
                 */
                slogan.style.transform =
                    'translate3d(-50%, -50%, 0)';


                keyword.style.transform =
                    'translate3d(-50%, -50%, 0)';


                states.push({
                    scene: scene,
                    stage: stage,
                    base: base,
                    cover: cover,
                    slogan: slogan,
                    description: description,
                    keyword: keyword
                });

            });

        });


        /* ==================================================
           스크롤 상태 계산
        ================================================== */

        function updateState(state) {

            const rect =
                state.scene
                    .getBoundingClientRect();


            const viewportHeight =
                window.innerHeight;


            const scrollDistance =
                Math.max(
                    state.scene.offsetHeight -
                    viewportHeight,
                    1
                );


            const progress =
                clamp(
                    -rect.top /
                    scrollDistance,
                    0,
                    1
                );


            /*
             * 1. 첫 영문 제목 사라짐
             *
             * 0%~22% 유지
             * 22%~34% 사라짐
             */
            const sloganOut =
                smootherStep(
                    range(
                        progress,
                        0.22,
                        0.34
                    )
                );


            const sloganOpacity =
                1 -
                sloganOut;


            state.slogan.style.opacity =
                String(
                    sloganOpacity
                );


            state.slogan.style.visibility =
                sloganOpacity > 0.002
                    ? 'visible'
                    : 'hidden';


            state.slogan.style.transform =
                'translate3d(-50%, -50%, 0) ' +
                'translateY(' +
                lerp(
                    0,
                    -35,
                    sloganOut
                ) +
                'px)';


            /*
             * 2. 실제 너비 분할
             *
             * 36%부터 시작
             * 64%에서 50:50 완성
             */
            const splitProgress =
                smootherStep(
                    range(
                        progress,
                        0.32,
                        0.78
                    )
                );
            /*
 * 스크롤 전에는 오른쪽 패널을 완전히 숨김
 * 분할이 시작되는 순간에만 표시
 */
if (splitProgress <= 0.001) {

    state.cover.style.setProperty(
        'opacity',
        '0',
        'important'
    );

    state.cover.style.setProperty(
        'visibility',
        'hidden',
        'important'
    );

    state.cover.style.setProperty(
        'padding',
        '0',
        'important'
    );

} else {

    state.cover.style.setProperty(
        'opacity',
        '1',
        'important'
    );

    state.cover.style.setProperty(
        'visibility',
        'visible',
        'important'
    );

    /*
     * 패널이 조금 열린 다음부터 패딩도 함께 생김
     */
    const coverPadding =
        lerp(
            0,
            window.innerWidth <= 767
                ? 25
                : window.innerWidth <= 1024
                    ? 40
                    : 60,
            splitProgress
        );

        state.cover.style.setProperty(
            'padding',
            coverPadding + 'px',
            'important'
        );

}

            const style =
                window.getComputedStyle(
                    state.scene
                );


            const gap =
                parseFloat(
                    style.getPropertyValue(
                        '--split-gap'
                    )
                ) || 30;


            if (
                window.innerWidth <= 767
            ) {

                /*
                 * 모바일
                 *
                 * 기본 이미지 높이:
                 * 100% → 50% - 간격 절반
                 *
                 * 오른쪽 패널:
                 * 아래쪽에서 높이 0% → 50% - 간격 절반
                 */
                const baseHeight =
                    lerp(
                        100,
                        50,
                        splitProgress
                    );


                const coverHeight =
                    50 *
                    splitProgress;


                state.base.style.setProperty(
                    'width',
                    '100%',
                    'important'
                );


                state.base.style.setProperty(
                    'height',
                    'calc(' +
                    baseHeight +
                    '% - ' +
                    (
                        splitProgress *
                        gap /
                        2
                    ) +
                    'px)',
                    'important'
                );


                state.cover.style.setProperty(
                    'width',
                    '100%',
                    'important'
                );


                state.cover.style.setProperty(
                    'height',
                    'calc(' +
                    coverHeight +
                    '% - ' +
                    (
                        splitProgress *
                        gap /
                        2
                    ) +
                    'px)',
                    'important'
                );

            } else {

                /*
                 * 데스크톱·태블릿
                 *
                 * 기본 이미지 실제 너비:
                 * 100% → 50% - 간격 절반
                 *
                 * 오른쪽 패널 실제 너비:
                 * 0% → 50% - 간격 절반
                 */
                const baseWidth =
                    lerp(
                        100,
                        50,
                        splitProgress
                    );


                const coverWidth =
                    50 *
                    splitProgress;


                state.base.style.setProperty(
                    'width',
                    'calc(' +
                    baseWidth +
                    '% - ' +
                    (
                        splitProgress *
                        gap /
                        2
                    ) +
                    'px)',
                    'important'
                );


                state.base.style.setProperty(
                    'height',
                    '100%',
                    'important'
                );


                state.cover.style.setProperty(
                    'width',
                    'calc(' +
                    coverWidth +
                    '% - ' +
                    (
                        splitProgress *
                        gap /
                        2
                    ) +
                    'px)',
                    'important'
                );


                state.cover.style.setProperty(
                    'height',
                    '100%',
                    'important'
                );

            }


            /*
             * 3. 오른쪽 설명 등장
             *
             * 오른쪽 패널이 어느 정도 커진 뒤 표시
             */
            const descriptionProgress =
                smootherStep(
                    range(
                        progress,
                        0.62,
                        0.82
                    )
                );


            state.description.style.opacity =
                String(
                    descriptionProgress
                );


            state.description.style.visibility =
                descriptionProgress > 0.002
                    ? 'visible'
                    : 'hidden';


            state.description.style.transform =
                'translate3d(' +
                lerp(
                    45,
                    0,
                    descriptionProgress
                ) +
                'px, 0, 0)';


            /*
             * 4. 왼쪽 핵심 단어 등장
             *
             * 오른쪽 설명보다 조금 늦게 표시
             */
            const keywordProgress =
                smootherStep(
                    range(
                        progress,
                        0.74,
                        0.90
                    )
                );


            state.keyword.style.opacity =
                String(
                    keywordProgress
                );


            state.keyword.style.visibility =
                keywordProgress > 0.002
                    ? 'visible'
                    : 'hidden';


            state.keyword.style.transform =
                'translate3d(-50%, -50%, 0) ' +
                'translateY(' +
                lerp(
                    35,
                    0,
                    keywordProgress
                ) +
                'px)';

        }


        /* ==================================================
           스크롤 이벤트
        ================================================== */

        let ticking =
            false;


        function update() {

            states.forEach(function (state) {

                updateState(state);

            });


            ticking =
                false;

        }


        function requestUpdate() {

            if (ticking) {
                return;
            }


            ticking =
                true;


            window.requestAnimationFrame(
                update
            );

        }


        window.addEventListener(
            'scroll',
            requestUpdate,
            {
                passive: true
            }
        );


        window.addEventListener(
            'resize',
            requestUpdate
        );


        window.addEventListener(
            'orientationchange',
            function () {

                window.setTimeout(
                    requestUpdate,
                    250
                );

            }
        );


        window.addEventListener(
            'load',
            requestUpdate
        );


        window.setTimeout(
            requestUpdate,
            100
        );


        window.setTimeout(
            requestUpdate,
            600
        );


        window.setTimeout(
            requestUpdate,
            1200
        );


        requestUpdate();

    }


    if (
        document.readyState ===
        'loading'
    ) {

        document.addEventListener(
            'DOMContentLoaded',
            initSancRealSplit
        );

    } else {

        initSancRealSplit();

    }

})();
</script>
