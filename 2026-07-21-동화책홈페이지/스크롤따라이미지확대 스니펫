/**
 * PIO POWER 가로 클리핑 스크롤 효과
 *
 * 작동 방식:
 * - 이미지 자체 크기는 처음부터 가로 100%
 * - 화면 아래에서 올라올 때는 양쪽이 잘린 상태
 * - 화면 안으로 들어오면서 양쪽 잘림이 점점 해제
 * - 해당 영역이 화면 상단에 도착할 때 전체 폭으로 펼쳐짐
 * - 펼쳐진 뒤 PIO POWER 제목 등장
 *
 * 기존 페이지에서 등록한 seanhaha-gsap을 사용합니다.
 */

function seanhaha_pio_clip_reveal_motion() {

    /* ==================================================
       CSS
    ================================================== */

    $pio_clip_css = <<<'CSS'

/* ==================================================
   전체 스크롤 구간
================================================== */

body .pio-zoom-section {
    --pio-scroll-height: 300vh;

    position: relative !important;
    display: block !important;

    width: 100vw !important;
    max-width: none !important;

    height: var(--pio-scroll-height) !important;
    min-height: var(--pio-scroll-height) !important;

    margin: 0 0 0 calc(50% - 50vw) !important;
    padding: 0 !important;

    overflow: visible !important;

    background: #ffffff;

    box-sizing: border-box !important;
    isolation: isolate;
}


/* Elementor 내부 래퍼 */
body .pio-zoom-section > .e-con-inner {
    position: relative !important;
    display: block !important;

    width: 100% !important;
    max-width: none !important;

    height: 100% !important;
    min-height: 100% !important;

    margin: 0 !important;
    padding: 0 !important;

    overflow: visible !important;
}


/*
 * sticky를 방해하는 상위 요소에
 * JavaScript가 자동으로 붙이는 클래스
 */
body .pio-clip-sticky-parent {
    overflow: visible !important;
    overflow-x: visible !important;
    overflow-y: visible !important;
}


/* ==================================================
   화면에 고정되는 무대
================================================== */

body .pio-zoom-stage {
    position: sticky !important;
    top: 0 !important;

    display: block !important;

    width: 100vw !important;
    max-width: none !important;

    height: 100vh !important;
    min-height: 100vh !important;

    margin: 0 !important;
    padding: 42px 3vw !important;

    overflow: hidden !important;

    background: #ffffff;

    box-sizing: border-box !important;
    isolation: isolate;
}


/* Elementor 내부 래퍼 */
body .pio-zoom-stage > .e-con-inner {
    position: relative !important;
    display: block !important;

    width: 100% !important;
    max-width: none !important;

    height: 100% !important;
    min-height: 100% !important;

    margin: 0 !important;
    padding: 0 !important;

    overflow: visible !important;
}


/* ==================================================
   가로 100% 이미지

   실제 크기는 처음부터 100%입니다.
   양쪽만 clip-path로 가립니다.
================================================== */

body .pio-zoom-media {
    --pio-clip-space: 34%;

    position: absolute !important;

    inset: 0 !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    width: 100% !important;
    max-width: none !important;

    height: 100% !important;
    min-height: 100% !important;
    max-height: none !important;

    margin: 0 !important;
    padding: 0 !important;

    overflow: hidden !important;

    clip-path: inset(
        0
        var(--pio-clip-space)
        0
        var(--pio-clip-space)
        round 76px
    );

    -webkit-clip-path: inset(
        0
        var(--pio-clip-space)
        0
        var(--pio-clip-space)
        round 76px
    );

    background-position: center center !important;
    background-repeat: no-repeat !important;
    background-size: cover !important;

    box-sizing: border-box !important;

    z-index: 2 !important;

    transform: none !important;

    will-change: clip-path;
}


/* 미디어 내부 Elementor 래퍼 */
body .pio-zoom-media > .e-con-inner {
    position: relative !important;
    z-index: 3 !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    width: 100% !important;
    max-width: none !important;

    height: 100% !important;
    min-height: 100% !important;

    margin: 0 !important;
    padding: 0 !important;

    overflow: hidden !important;
}


/* 이미지 위 약한 음영 */
body .pio-zoom-media::after {
    content: "";

    position: absolute;
    inset: 0;

    z-index: 1;

    background: rgba(0, 0, 0, 0.08);

    pointer-events: none;
}


/* Elementor 배경 오버레이 */
body .pio-zoom-media >
.elementor-background-overlay {
    z-index: 2 !important;
}


/* ==================================================
   이미지 위 제목
================================================== */

body .pio-zoom-title {
    position: absolute !important;

    left: 50% !important;
    top: 50% !important;

    width: 100% !important;
    max-width: none !important;

    margin: 0 !important;
    padding: 0 30px !important;

    z-index: 10 !important;

    text-align: center !important;

    opacity: 0;
    visibility: hidden;

    pointer-events: none !important;

    will-change: opacity, transform;
}


/* 제목 내부 */
body .pio-zoom-title .elementor-widget-container {
    width: 100% !important;

    margin: 0 !important;
    padding: 0 !important;

    text-align: center !important;
}


/* 제목 글자 */
body .pio-zoom-title .elementor-heading-title {
    margin: 0 !important;
    padding: 0 !important;

    color: #ffffff !important;

    font-size: clamp(
        50px,
        8vw,
        100px
    ) !important;

    line-height: 0.95 !important;

    font-weight: 400 !important;

    letter-spacing: -0.055em !important;

    text-align: center !important;

    white-space: nowrap;
}


/* Elementor 기본 등장 효과 제거 */
body .pio-zoom-title.elementor-invisible {
    visibility: visible !important;
}

body .pio-zoom-title.animated {
    animation: none !important;
}


/* ==================================================
   태블릿
================================================== */

@media screen and (max-width: 1024px) {

    body .pio-zoom-section {
        --pio-scroll-height: 280vh;
    }

    body .pio-zoom-stage {
        padding: 34px 24px !important;
    }

    body .pio-zoom-media {
        --pio-clip-space: 27%;

        clip-path: inset(
            0
            var(--pio-clip-space)
            0
            var(--pio-clip-space)
            round 58px
        );

        -webkit-clip-path: inset(
            0
            var(--pio-clip-space)
            0
            var(--pio-clip-space)
            round 58px
        );
    }

}


/* ==================================================
   모바일
================================================== */

@media screen and (max-width: 767px) {

    body .pio-zoom-section {
        --pio-scroll-height: 250vh;
    }

    body .pio-zoom-stage {
        padding: 20px 16px !important;
    }

    body .pio-zoom-media {
        --pio-clip-space: 14%;

        clip-path: inset(
            0
            var(--pio-clip-space)
            0
            var(--pio-clip-space)
            round 34px
        );

        -webkit-clip-path: inset(
            0
            var(--pio-clip-space)
            0
            var(--pio-clip-space)
            round 34px
        );
    }

    body .pio-zoom-title {
        padding: 0 15px !important;
    }

    body .pio-zoom-title .elementor-heading-title {
        font-size: clamp(
            42px,
            15vw,
            78px
        ) !important;
    }

}

CSS;


    wp_register_style(
        'seanhaha-pio-clip-style',
        false,
        array(),
        '4.0.0'
    );

    wp_enqueue_style(
        'seanhaha-pio-clip-style'
    );

    wp_add_inline_style(
        'seanhaha-pio-clip-style',
        $pio_clip_css
    );


    /* ==================================================
       JavaScript
    ================================================== */

    $pio_clip_js = <<<'JS'

(function () {

    'use strict';


    /*
     * 중복 실행 방지
     */
    if (
        window.seanhahaPioClipRevealStarted
    ) {
        return;
    }


    window.seanhahaPioClipRevealStarted =
        true;


    /* ==================================================
       계산 함수
    ================================================== */

    function clamp(
        value,
        min,
        max
    ) {

        return Math.min(
            Math.max(
                value,
                min
            ),
            max
        );

    }


    function range(
        value,
        start,
        end
    ) {

        if (start === end) {
            return 0;
        }


        return clamp(
            (
                value -
                start
            ) /
            (
                end -
                start
            ),
            0,
            1
        );

    }


    function smootherStep(value) {

        value =
            clamp(
                value,
                0,
                1
            );


        return value *
            value *
            value *
            (
                value *
                (
                    value * 6 -
                    15
                ) +
                10
            );

    }


    function lerp(
        start,
        end,
        progress
    ) {

        return start +
            (
                end -
                start
            ) *
            progress;

    }


    /*
     * 시작 시 양쪽이 잘리는 비율
     */
    function getStartClip() {

        if (
            window.innerWidth <= 767
        ) {
            return 14;
        }


        if (
            window.innerWidth <= 1024
        ) {
            return 27;
        }


        return 34;

    }


    /*
     * 시작 모서리 둥글기
     */
    function getStartRadius() {

        if (
            window.innerWidth <= 767
        ) {
            return 34;
        }


        if (
            window.innerWidth <= 1024
        ) {
            return 58;
        }


        return 76;

    }


    /* ==================================================
       효과 초기화
    ================================================== */

    function initPioClipReveal() {

        if (
            typeof window.gsap ===
            'undefined'
        ) {
            return false;
        }


        const sections =
            Array.from(
                document.querySelectorAll(
                    '.pio-zoom-section'
                )
            );


        if (!sections.length) {
            return true;
        }


        const states =
            [];


        sections.forEach(
            function (section) {

                const stage =
                    section.querySelector(
                        '.pio-zoom-stage'
                    );


                const media =
                    section.querySelector(
                        '.pio-zoom-media'
                    );


                const title =
                    section.querySelector(
                        '.pio-zoom-title'
                    );


                if (
                    !stage ||
                    !media ||
                    !title
                ) {

                    console.warn(
                        'PIO 클리핑 효과: stage, media 또는 title 클래스를 찾지 못했습니다.',
                        section
                    );

                    return;

                }


                /*
                 * Elementor 등장 효과 제거
                 */
                title.classList.remove(
                    'elementor-invisible',
                    'animated',
                    'fadeIn',
                    'fadeInUp',
                    'fadeInDown',
                    'zoomIn'
                );


                /*
                 * sticky를 방해하는 상위 요소 보정
                 */
                let parent =
                    section.parentElement;


                while (
                    parent &&
                    parent !==
                    document.body
                ) {

                    const style =
                        window
                            .getComputedStyle(
                                parent
                            );


                    if (
                        style.overflow ===
                            'hidden' ||
                        style.overflow ===
                            'clip' ||
                        style.overflowY ===
                            'hidden' ||
                        style.overflowY ===
                            'clip' ||
                        style.overflowY ===
                            'auto' ||
                        style.overflowY ===
                            'scroll'
                    ) {

                        parent.classList.add(
                            'pio-clip-sticky-parent'
                        );

                    }


                    parent =
                        parent.parentElement;

                }


                /*
                 * 제목 중앙 정렬 및 초기 상태
                 */
                window.gsap.set(
                    title,
                    {
                        xPercent:
                            -50,

                        yPercent:
                            -50,

                        x:
                            0,

                        y:
                            48,

                        scale:
                            0.94,

                        opacity:
                            0,

                        visibility:
                            'hidden',

                        force3D:
                            true
                    }
                );


                states.push({

                    section:
                        section,

                    stage:
                        stage,

                    media:
                        media,

                    title:
                        title

                });

            }
        );


        if (!states.length) {
            return true;
        }


        /* ==================================================
           현재 스크롤 상태 계산
        ================================================== */

        function updateState(state) {

            const rect =
                state.section
                    .getBoundingClientRect();


            const viewportHeight =
                window.innerHeight;


            const scrollDistance =
                Math.max(
                    state.section
                        .offsetHeight -
                    viewportHeight,
                    1
                );


            /*
             * 화면 진입 진행률
             *
             * section 위쪽이 화면 하단에 있을 때 0
             * section 위쪽이 화면 상단에 도착할 때 1
             *
             * 이 값으로 이미지가 아래에서 올라오는 동안
             * 양쪽이 점점 펼쳐집니다.
             */
            const entryProgress =
                clamp(
                    (
                        viewportHeight -
                        rect.top
                    ) /
                    viewportHeight,
                    0,
                    1
                );


            /*
             * sticky 구간 진행률
             *
             * 이미지가 완전히 펼쳐진 뒤
             * 제목을 보여주는 데 사용합니다.
             */
            const stickyProgress =
                clamp(
                    -rect.top /
                    scrollDistance,
                    0,
                    1
                );


            /*
             * 양쪽 잘림 해제
             *
             * entryProgress 0.02부터 시작
             * entryProgress 0.90에서 완성
             *
             * section이 화면 맨 위에 닿기 조금 전에
             * 이미 가로 100%로 펼쳐집니다.
             */
            const revealProgress =
                smootherStep(
                    range(
                        entryProgress,
                        0.02,
                        0.90
                    )
                );


            const startClip =
                getStartClip();


            const currentClip =
                lerp(
                    startClip,
                    0,
                    revealProgress
                );


            const startRadius =
                getStartRadius();


            /*
             * 마지막에도 둥근 모서리를 유지
             */
            const endRadius =
                70;


            const currentRadius =
                lerp(
                    startRadius,
                    endRadius,
                    revealProgress
                );


            const clipValue =
                'inset(' +
                '0 ' +
                currentClip +
                '% 0 ' +
                currentClip +
                '% round ' +
                currentRadius +
                'px)';


            state.media.style.setProperty(
                'clip-path',
                clipValue,
                'important'
            );


            state.media.style.setProperty(
                '-webkit-clip-path',
                clipValue,
                'important'
            );


            state.media.style.setProperty(
                '--pio-clip-space',
                currentClip + '%'
            );


            /*
             * 이미지가 완전히 펼쳐진 뒤 제목 등장
             */
            const titleProgress =
                smootherStep(
                    range(
                        stickyProgress,
                        0.04,
                        0.26
                    )
                );


            window.gsap.set(
                state.title,
                {
                    opacity:
                        titleProgress,

                    y:
                        lerp(
                            48,
                            0,
                            titleProgress
                        ),

                    scale:
                        lerp(
                            0.94,
                            1,
                            titleProgress
                        ),

                    visibility:
                        titleProgress > 0.01
                            ? 'visible'
                            : 'hidden'
                }
            );

        }


        /* ==================================================
           스크롤 업데이트
        ================================================== */

        let ticking =
            false;


        function update() {

            states.forEach(
                function (state) {

                    updateState(
                        state
                    );

                }
            );


            ticking =
                false;

        }


        function requestUpdate() {

            if (ticking) {
                return;
            }


            ticking =
                true;


            window.requestAnimationFrame(
                update
            );

        }


        /*
         * 스크롤할 때 계속 갱신
         */
        window.addEventListener(
            'scroll',
            requestUpdate,
            {
                passive: true
            }
        );


        /*
         * 화면 크기 변경 대응
         */
        window.addEventListener(
            'resize',
            requestUpdate
        );


        /*
         * 모바일 방향 전환 대응
         */
        window.addEventListener(
            'orientationchange',
            function () {

                window.setTimeout(
                    requestUpdate,
                    250
                );

            }
        );


        /*
         * 이미지와 페이지 로딩 후 재계산
         */
        window.addEventListener(
            'load',
            requestUpdate
        );


        window.setTimeout(
            requestUpdate,
            100
        );


        window.setTimeout(
            requestUpdate,
            500
        );


        window.setTimeout(
            requestUpdate,
            1200
        );


        /*
         * 최초 화면 표시
         */
        requestUpdate();


        return true;

    }


    /* ==================================================
       기존 GSAP 로딩 대기
    ================================================== */

    let attempts =
        0;


    const waitForGsap =
        window.setInterval(
            function () {

                attempts +=
                    1;


                if (
                    typeof window.gsap !==
                    'undefined'
                ) {

                    window.clearInterval(
                        waitForGsap
                    );


                    initPioClipReveal();

                    return;

                }


                if (
                    attempts >=
                    100
                ) {

                    window.clearInterval(
                        waitForGsap
                    );


                    console.error(
                        'PIO 클리핑 효과: GSAP가 10초 안에 로드되지 않았습니다.'
                    );

                }

            },
            100
        );

})();

JS;


    /*
     * 기존 GSAP 뒤에 실행
     */
    wp_add_inline_script(
        'seanhaha-gsap',
        $pio_clip_js,
        'after'
    );

}


/*
 * 기존 애니메이션보다 뒤에서 실행
 */
add_action(
    'wp_enqueue_scripts',
    'seanhaha_pio_clip_reveal_motion',
    170
);
