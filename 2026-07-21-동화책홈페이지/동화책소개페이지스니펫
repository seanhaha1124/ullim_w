add_action('wp_footer', function () {
?>
<script id="sanc-split-story-script">
(function () {

    'use strict';


    if (window.seanhahaSancSplitRevealStarted) {
        return;
    }

    window.seanhahaSancSplitRevealStarted = true;


    function clamp(value, min, max) {

        return Math.min(
            Math.max(value, min),
            max
        );

    }


    function range(value, start, end) {

        if (start === end) {
            return 0;
        }

        return clamp(
            (value - start) /
            (end - start),
            0,
            1
        );

    }


    function smootherStep(value) {

        value = clamp(
            value,
            0,
            1
        );

        return value *
            value *
            value *
            (
                value *
                (
                    value * 6 -
                    15
                ) +
                10
            );

    }


    function lerp(start, end, progress) {

        return start +
            (
                end -
                start
            ) *
            progress;

    }


    function removeElementorMotion(element) {

        if (!element) {
            return;
        }

        element.classList.remove(
            'elementor-invisible',
            'animated',
            'fadeIn',
            'fadeInUp',
            'fadeInDown',
            'fadeInLeft',
            'fadeInRight',
            'zoomIn'
        );

    }


    function initSancSplitReveal() {

        const stories =
            Array.from(
                document.querySelectorAll(
                    '.sanc-split-story'
                )
            );


        if (!stories.length) {
            return;
        }


        const states =
            [];


        stories.forEach(function (story) {

            const scenes =
                Array.from(
                    story.querySelectorAll(
                        '.sanc-split-scene'
                    )
                ).filter(function (scene) {

                    return (
                        scene.closest(
                            '.sanc-split-story'
                        ) === story
                    );

                });


            scenes.forEach(function (scene) {

                const stage =
                    scene.querySelector(
                        '.sanc-split-stage'
                    );

                const cover =
                    scene.querySelector(
                        '.sanc-split-cover'
                    );

                const slogan =
                    scene.querySelector(
                        '.sanc-split-slogan'
                    );

                const description =
                    scene.querySelector(
                        '.sanc-split-description'
                    );

                const keyword =
                    scene.querySelector(
                        '.sanc-split-keyword'
                    );


                if (
                    !stage ||
                    !cover ||
                    !slogan ||
                    !description ||
                    !keyword
                ) {

                    console.warn(
                        'SANC 분할 효과: 필요한 클래스가 빠졌습니다.',
                        scene
                    );

                    return;

                }


                [
                    slogan,
                    description,
                    keyword
                ].forEach(
                    removeElementorMotion
                );


                /*
                 * sticky 방해 상위 요소 보정
                 */
                let parent =
                    scene.parentElement;


                while (
                    parent &&
                    parent !== document.body
                ) {

                    const style =
                        window.getComputedStyle(
                            parent
                        );


                    if (
                        style.overflow === 'hidden' ||
                        style.overflow === 'clip' ||
                        style.overflowY === 'hidden' ||
                        style.overflowY === 'clip' ||
                        style.overflowY === 'auto' ||
                        style.overflowY === 'scroll'
                    ) {

                        parent.classList.add(
                            'sanc-split-sticky-parent'
                        );

                    }


                    parent =
                        parent.parentElement;

                }


                /*
                 * 요소 중앙 정렬
                 */
                slogan.style.transform =
                    'translate3d(-50%, -50%, 0)';


                keyword.style.transform =
                    'translate3d(-50%, -50%, 0)';


                states.push({
                    scene: scene,
                    stage: stage,
                    cover: cover,
                    slogan: slogan,
                    description: description,
                    keyword: keyword
                });

            });

        });


        function updateState(state) {

            const rect =
                state.scene
                    .getBoundingClientRect();


            const viewportHeight =
                window.innerHeight;


            const scrollDistance =
                Math.max(
                    state.scene.offsetHeight -
                    viewportHeight,
                    1
                );


            const progress =
                clamp(
                    -rect.top /
                    scrollDistance,
                    0,
                    1
                );


            /*
             * ==================================================
             * 1. 첫 영문 글씨 사라짐
             *
             * 0%~22%는 그대로 표시
             * 22%~34% 사이에서 사라짐
             * ==================================================
             */

            const sloganOut =
                smootherStep(
                    range(
                        progress,
                        0.22,
                        0.34
                    )
                );


            const sloganOpacity =
                1 -
                sloganOut;


            state.slogan.style.opacity =
                String(
                    sloganOpacity
                );


            state.slogan.style.visibility =
                sloganOpacity > 0.002
                    ? 'visible'
                    : 'hidden';


            state.slogan.style.transform =
                'translate3d(-50%, -50%, 0) ' +
                'translateY(' +
                lerp(
                    0,
                    -35,
                    sloganOut
                ) +
                'px)';


            /*
             * ==================================================
             * 2. 오른쪽 패널 공개
             *
             * 영문 글씨가 거의 사라진 뒤 시작
             * 36%부터 시작해서 62%에서 완성
             * ==================================================
             */

            const coverProgress =
                smootherStep(
                    range(
                        progress,
                        0.36,
                        0.62
                    )
                );


            const hiddenAmount =
                lerp(
                    100,
                    0,
                    coverProgress
                );


            let clipValue;


            if (
                window.innerWidth <=
                767
            ) {

                clipValue =
                    'inset(' +
                    hiddenAmount +
                    '% 0 0 0 round var(--split-radius))';

            } else {

                clipValue =
                    'inset(0 0 0 ' +
                    hiddenAmount +
                    '% round var(--split-radius))';

            }


            state.cover.style.setProperty(
                'clip-path',
                clipValue,
                'important'
            );


            state.cover.style.setProperty(
                '-webkit-clip-path',
                clipValue,
                'important'
            );


            /*
             * ==================================================
             * 3. 가운데 흰색 간격
             *
             * 패널이 어느 정도 공개된 뒤 나타남
             * ==================================================
             */

            const dividerProgress =
                smootherStep(
                    range(
                        progress,
                        0.45,
                        0.62
                    )
                );


            state.stage.style.setProperty(
                '--divider-opacity',
                dividerProgress
            );


            /*
             * pseudo-element는 직접 선택할 수 없으므로
             * stage에 클래스를 넣고 CSS 변수로 제어
             */
            state.stage.style.setProperty(
                '--split-divider-opacity',
                dividerProgress
            );


            state.stage.style.setProperty(
                '--split-divider-scale',
                lerp(
                    0.92,
                    1,
                    dividerProgress
                )
            );


            /*
             * ==================================================
             * 4. 오른쪽 설명 등장
             *
             * 패널이 대부분 열린 뒤 먼저 등장
             * ==================================================
             */

            const descriptionProgress =
                smootherStep(
                    range(
                        progress,
                        0.55,
                        0.72
                    )
                );


            state.description.style.opacity =
                String(
                    descriptionProgress
                );


            state.description.style.visibility =
                descriptionProgress > 0.002
                    ? 'visible'
                    : 'hidden';


            state.description.style.transform =
                'translate3d(' +
                lerp(
                    45,
                    0,
                    descriptionProgress
                ) +
                'px, 0, 0)';


            /*
             * ==================================================
             * 5. 왼쪽 핵심 글씨 등장
             *
             * 오른쪽 설명보다 조금 늦게 등장
             * ==================================================
             */

            const keywordProgress =
                smootherStep(
                    range(
                        progress,
                        0.66,
                        0.82
                    )
                );


            state.keyword.style.opacity =
                String(
                    keywordProgress
                );


            state.keyword.style.visibility =
                keywordProgress > 0.002
                    ? 'visible'
                    : 'hidden';


            state.keyword.style.transform =
                'translate3d(-50%, -50%, 0) ' +
                'translateY(' +
                lerp(
                    35,
                    0,
                    keywordProgress
                ) +
                'px)';

        }


        let ticking =
            false;


        function update() {

            states.forEach(function (state) {

                updateState(state);

            });


            ticking =
                false;

        }


        function requestUpdate() {

            if (ticking) {
                return;
            }


            ticking =
                true;


            window.requestAnimationFrame(
                update
            );

        }


        window.addEventListener(
            'scroll',
            requestUpdate,
            {
                passive: true
            }
        );


        window.addEventListener(
            'resize',
            requestUpdate
        );


        window.addEventListener(
            'orientationchange',
            function () {

                window.setTimeout(
                    requestUpdate,
                    250
                );

            }
        );


        window.addEventListener(
            'load',
            requestUpdate
        );


        window.setTimeout(
            requestUpdate,
            100
        );


        window.setTimeout(
            requestUpdate,
            600
        );


        requestUpdate();

    }


    if (
        document.readyState ===
        'loading'
    ) {

        document.addEventListener(
            'DOMContentLoaded',
            initSancSplitReveal
        );

    } else {

        initSancSplitReveal();

    }

})();
</script>
<?php
}, 100);
