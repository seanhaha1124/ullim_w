.dp-booking-inner{display:grid;grid-template-columns:1fr 1fr;min-height:700px;width:100%}
.dp-booking-photos{position:relative;overflow:visible;min-height:700px}
.dp-bphoto{position:absolute;overflow:hidden;will-change:transform}
.dp-bphoto img{width:100%;height:100%;object-fit:cover;display:block}
.dp-bp1{width:46%;height:auto;left:0;top:0}
.dp-bp2{width:40%;height:auto;left:22%;top:18%}
.dp-bp3{width:43%;height:auto;left:5%;top:46%}
.dp-bp4{width:38%;height:auto;left:28%;top:62%}
.dp-bphoto img{width:100%;height:auto;display:block}

.dp-booking-form{padding:60px 6vw 60px 40px;display:flex;flex-direction:column;justify-content:center}
.dp-booking-form h2{font-family:Georgia,serif;color:#F4C00C;font-size:clamp(36px,4vw,64px);font-weight:400;margin:0 0 48px;line-height:1.1;text-transform:uppercase}
.dp-form-row{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:24px}
.dp-form-field{display:flex;flex-direction:column;gap:8px}
.dp-form-field label{font-size:10px;letter-spacing:.25em;text-transform:uppercase;color:rgba(255,255,255,.5);font-family:sans-serif}
.dp-form-field input,.dp-form-field select,.dp-form-field textarea{background:transparent;border:none;border-bottom:1px solid rgba(255,255,255,.25);color:#fff;font-size:14px;font-family:sans-serif;padding:8px 0;outline:none;transition:border-color .3s;-webkit-appearance:none}
.dp-form-field input:focus,.dp-form-field select:focus,.dp-form-field textarea:focus{border-bottom-color:#F4C00C}
.dp-form-field select option{background:#1a1608;color:#fff}
.dp-form-field textarea{resize:none;height:80px}
.dp-form-field.full{grid-column:1/-1}
.dp-form-submit{margin-top:32px}
.dp-form-submit button{background:transparent;border:1px solid #F4C00C;color:#F4C00C;font-size:11px;letter-spacing:.3em;text-transform:uppercase;padding:14px 36px;font-family:sans-serif;cursor:pointer;transition:background .3s,color .3s}
.dp-form-submit button:hover{background:#F4C00C;color:#0a0802}

/* 폼 입력 글씨 색상 */
.dp-form-field input,
.dp-form-field select,
.dp-form-field textarea{
    color:#fff !important;
    -webkit-text-fill-color:#fff !important;
    caret-color:#F4C00C;
}

/* placeholder 글씨 색상 */
.dp-form-field input::placeholder,
.dp-form-field textarea::placeholder{
    color:rgba(255,255,255,.45) !important;
    -webkit-text-fill-color:rgba(255,255,255,.45) !important;
}

/* 자동완성 시 검은 글씨/흰 배경 방지 */
.dp-form-field input:-webkit-autofill,
.dp-form-field input:-webkit-autofill:hover,
.dp-form-field input:-webkit-autofill:focus{
    -webkit-text-fill-color:#fff !important;
    box-shadow:0 0 0 1000px #111007 inset !important;
    transition:background-color 9999s ease-in-out 0s;
}


.dp-privacy-box{
    margin-top:8px;
    margin-bottom:24px;
    font-family:'Noto Sans KR', sans-serif;
}

.dp-privacy-label{
    display:flex;
    align-items:flex-start;
    gap:10px;
    color:rgba(255,255,255,.86);
    font-size:13px;
    line-height:1.5;
    cursor:pointer;
}

.dp-privacy-label input{
    width:16px;
    height:16px;
    margin-top:3px;
    accent-color:#F4C00C;
}

.dp-privacy-label strong{
    color:#F4C00C;
