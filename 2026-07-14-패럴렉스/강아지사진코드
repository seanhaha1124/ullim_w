// ★ HERO 8장
// 상단 이미지 움직임을 더 크게 만든 버전입니다.
// 원본 비율은 CSS에서 유지하고, JS는 이동/회전/속도만 제어합니다.
const fpConfig=[
    {id:'dp-fp1', type:'fly',      ox:-620, oy:220,  rot0:-22, rot1:10,  y:-760, x:180,  start:0.00, end:0.78},
    {id:'dp-fp3', type:'fly',      ox:620,  oy:180,  rot0:24,  rot1:-12, y:-820, x:-180, start:0.02, end:0.82},
    {id:'dp-fp5', type:'fly',      ox:-560, oy:260,  rot0:18,  rot1:-14, y:-700, x:220,  start:0.06, end:0.86},

    {id:'dp-fp2', type:'parallax', ox:0,    oy:0,    rot0:-10, rot1:16,  y:-820, x:-120, start:0.00, end:1.00},
    {id:'dp-fp4', type:'parallax', ox:0,    oy:0,    rot0:13,  rot1:-14, y:680,  x:140,  start:0.00, end:1.00},
    {id:'dp-fp6', type:'parallax', ox:0,    oy:0,    rot0:-14, rot1:12,  y:-720, x:-150, start:0.00, end:1.00},
    {id:'dp-fp7', type:'parallax', ox:0,    oy:0,    rot0:16,  rot1:-10, y:620,  x:160,  start:0.00, end:1.00},
    {id:'dp-fp8', type:'parallax', ox:0,    oy:0,    rot0:-8,  rot1:18,  y:-760, x:100,  start:0.00, end:1.00},
];

function clamp(n,min,max){
    return Math.max(min, Math.min(max, n));
}

function lerp(a,b,t){
    return a + (b - a) * t;
}

function buildHero(){
    fpConfig.forEach((cfg,i)=>{
        const el=document.getElementById(cfg.id);
        if(!el)return;

       if(allPhotos[i]){
            const img = el.querySelector('img');
            setImageLoaded(img, allPhotos[i].url, allPhotos[i].alt);
        }

        if(cfg.type === 'fly'){
            el.style.opacity='0';
            el.style.transform=`translate3d(${cfg.ox}px,${cfg.oy}px,0) rotate(${cfg.rot0}deg)`;
        }else{
            el.style.opacity='1';
            el.style.transform=`translate3d(0,0,0) rotate(${cfg.rot0}deg)`;
        }
    });

    requestAnimationFrame(updateHeroParallax);
}

function updateHeroParallax(){
    const hero=document.getElementById('dp-hero');
    if(!hero)return;

    const rect = hero.getBoundingClientRect();
    const total = window.innerHeight + rect.height;

    /*
     * 화면 기준 진행률.
     * scrollY / heroH 방식보다 움직임이 더 오래 이어집니다.
     */
    const progress = clamp((window.innerHeight - rect.top) / total, 0, 1);

    fpConfig.forEach((cfg)=>{
        const el=document.getElementById(cfg.id);
        if(!el)return;

        const local = clamp((progress - cfg.start) / (cfg.end - cfg.start), 0, 1);
        const eased = 1 - Math.pow(1 - local, 3);

        let tx;
        let ty;
        let rot = lerp(cfg.rot0, cfg.rot1, eased);
        let opacity = 1;

        if(cfg.type === 'fly'){
            tx = lerp(cfg.ox, cfg.x, eased);
            ty = lerp(cfg.oy, cfg.y * (progress - .22), eased);
            opacity = eased;
        }else{
            tx = cfg.x * (progress - .5);
            ty = cfg.y * (progress - .5);
        }

        el.style.opacity = String(opacity);
        el.style.transform = `translate3d(${tx}px,${ty}px,0) rotate(${rot}deg)`;

        const img = el.querySelector('img');
        if(img){
            img.style.transform = `scale(${1 + progress * 0.055})`;
        }
    });
}

let heroTicking=false;
window.addEventListener('scroll',function(){
    if(heroTicking)return;

    heroTicking=true;

    requestAnimationFrame(()=>{
        updateHeroParallax();
        heroTicking=false;
    });
},{passive:true});

window.addEventListener('resize',updateHeroParallax);

// ★ 슬라이더
function buildSlider(){
    if(!allPhotos.length)return;

    const slidesEl=document.getElementById('dp-slides');
    const thumbsEl=document.getElementById('dp-thumbs-track');

    let cur=0;

    allPhotos.forEach((p,i)=>{
        const s=document.createElement('div');
        s.className='dp-slide'+(i===0?' active':'');

        const bg=document.createElement('div');
        bg.className='dp-slide-bg';
        bg.style.backgroundImage=`url("${p.url}")`;

        const inner=document.createElement('div');
        inner.className='dp-slide-inner';

        const mainImg=document.createElement('img');
        mainImg.className='dp-slide-main';
        mainImg.loading=i===0 ? 'eager' : 'lazy';

        /*
         * 이미지 원본 비율을 읽어서
         * 가로형 / 세로형 / 정사각형에 가까운 이미지로 나눔
         */
        mainImg.onload=function(){
            mainImg.classList.add('is-loaded');

            const ratio = mainImg.naturalWidth / mainImg.naturalHeight;

            mainImg.classList.remove('is-wide','is-tall','is-square');

            if(ratio > 1.55){
                /*
                 * 가로가 긴 이미지
                 * 화면 가로에 맞추되 세로가 넘치지 않게
                 */
                mainImg.classList.add('is-wide');
            }else if(ratio < 0.85){
                /*
                 * 세로가 긴 이미지
                 * 세로 높이에 맞추고 가로는 자동으로 줄어듦
                 */
                mainImg.classList.add('is-tall');
            }else{
                /*
                 * 정사각형에 가까운 이미지
                 */
                mainImg.classList.add('is-square');
            }
        };

        mainImg.onerror=function(){
            mainImg.classList.remove('is-loaded');
            mainImg.removeAttribute('src');
        };

        mainImg.alt=p.alt || '';
        mainImg.src=p.url;

        inner.appendChild(mainImg);

        s.appendChild(bg);
        s.appendChild(inner);
        slidesEl.appendChild(s);

        const t=document.createElement('div');
        t.className='dp-thumb'+(i===0?' active':'');

        const thumbImg=document.createElement('img');
        thumbImg.loading='lazy';
        setImageLoaded(thumbImg, p.url, p.alt);

        t.appendChild(thumbImg);
        t.addEventListener('click',()=>goSlide(i));
        thumbsEl.appendChild(t);
    });

    function goSlide(n){
        document.querySelectorAll('.dp-slide').forEach((s,i)=>{
            s.classList.toggle('active',i===n);
        });

        document.querySelectorAll('.dp-thumb').forEach((t,i)=>{
            t.classList.toggle('active',i===n);
        });

        cur=n;

        // 선택된 썸네일이 중앙에 오도록 자동 슬라이드
        const track=document.getElementById('dp-thumbs-track');
        const container=document.getElementById('dp-thumbs');

        const thumbW=83; // 80px + 3px gap
        const containerW=container.offsetWidth;

        const offset=Math.max(0, n*thumbW - containerW/2 + thumbW/2);
        const maxOffset=Math.max(0, allPhotos.length*thumbW - containerW);

        track.style.transform=`translateX(-${Math.min(offset,maxOffset)}px)`;
    }

    document.getElementById('dp-zone-left').addEventListener('click',()=>{
        goSlide((cur-1+allPhotos.length)%allPhotos.length);
    });

    document.getElementById('dp-zone-right').addEventListener('click',()=>{
        goSlide((cur+1)%allPhotos.length);
    });

    const slider=document.getElementById('dp-slider');

    slider.addEventListener('mousemove',e=>{
        const isRight=e.clientX>slider.offsetWidth/2;
        arrowPoly.setAttribute(
            'points',
            isRight ? '9,18 15,12 9,6' : '15,18 9,12 15,6'
        );
        setCursor('arrow');
    });

    slider.addEventListener('mouseleave',()=>{
        setCursor('dot');
    });
}


// ★ 예약 사진 4장
// 온라인문의 폼 왼쪽 이미지: 위아래 이동 없이, 왼쪽 → 오른쪽 + 각도 변화
const bpConfig=[
    {id:'dp-bp1', startX:-360, endX:20,  rot0:-14, rot1:4,  start:0.00, end:0.80},
    {id:'dp-bp2', startX:-300, endX:55,  rot0:10,  rot1:-6, start:0.08, end:0.88},
    {id:'dp-bp3', startX:-420, endX:10,  rot0:-9,  rot1:7,  start:0.16, end:0.96},
    {id:'dp-bp4', startX:-260, endX:70,  rot0:12,  rot1:-8, start:0.24, end:1.00},
];

function buildBookingPhotos(){
    bpConfig.forEach((cfg,i)=>{
        const el=document.getElementById(cfg.id);
        if(!el)return;

        const idx=allPhotos.length>8+i ? 8+i : i % Math.max(allPhotos.length,1);

        if(allPhotos[idx]){
            const img = el.querySelector('img');
            setImageLoaded(img, allPhotos[idx].url, allPhotos[idx].alt);
        }

        el.style.opacity='0';
        el.style.transition='none';
        el.style.transform=`translate3d(${cfg.startX}px,0,0) rotate(${cfg.rot0}deg)`;
    });

    updateBookingParallax();
}

function updateBookingParallax(){
    const section=document.getElementById('dp-booking');
    if(!section)return;

    const rect = section.getBoundingClientRect();
    const total = window.innerHeight + rect.height;
    const progress = clamp((window.innerHeight - rect.top) / total, 0, 1);

    bpConfig.forEach((cfg)=>{
        const el=document.getElementById(cfg.id);
        if(!el)return;

        const local = clamp((progress - cfg.start) / (cfg.end - cfg.start), 0, 1);

        /*
         * 부드럽게 들어오고, 끝에서 자연스럽게 멈추는 움직임
         */
        const eased = 1 - Math.pow(1 - local, 3);

        const x = lerp(cfg.startX, cfg.endX, eased);
        const rot = lerp(cfg.rot0, cfg.rot1, eased);

        el.style.opacity = String(Math.min(1, eased + 0.1));
        el.style.transition='none';
        el.style.transform=`translate3d(${x}px,0,0) rotate(${rot}deg)`;

        const img = el.querySelector('img');
        if(img){
            img.style.transform = `scale(${1 + eased * 0.035})`;
        }
    });
}

let bookingTicking=false;

window.addEventListener('scroll',function(){
    if(bookingTicking)return;

    bookingTicking=true;

    requestAnimationFrame(()=>{
        updateBookingParallax();
        bookingTicking=false;
    });
},{passive:true});

window.addEventListener('resize',updateBookingParallax);

// SoundCloud
const snd=document.getElementById('dp-snd');
const bars=document.querySelectorAll('#dp-wave .bar');
let playing=false,wRAF;
function animW(){bars.forEach(b=>{b.style.height=(4+Math.random()*12)+'px';});wRAF=requestAnimationFrame(animW);}
function stopW(){cancelAnimationFrame(wRAF);bars.forEach(b=>b.style.height='12px');}
function initSC(){
    if(typeof SC==='undefined'){setTimeout(initSC,300);return;}
    const widget=SC.Widget(snd);
    document.getElementById('dp-audio').addEventListener('click',()=>{
        if(!playing){widget.play();animW();playing=true;}
        else{widget.pause();stopW();playing=false;}
    });
}
initSC();

