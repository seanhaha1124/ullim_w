<style>
@import url('https://fonts.googleapis.com/css2?family=Gasoek+One&display=swap');
html,body{margin:0!important;padding:0!important;background:#111007!important;color:#fff;cursor:none!important;overflow-x:hidden!important;width:100%!important;max-width:100%!important}
*{box-sizing:border-box}
.elementor-widget-container,.elementor-widget-shortcode,.elementor-shortcode,.elementor-section,.elementor-container,.elementor-column,.elementor-widget-wrap{padding:0!important;margin:0!important;max-width:100%!important;width:100%!important}

#dp-cursor{position:fixed;pointer-events:none;top:0;left:0;z-index:100000}
.dp-cur-dot{position:absolute;transform:translate(-50%,-50%);width:10px;height:10px;border-radius:50%;background:#F4C00C;transition:width .2s,height .2s,opacity .2s}
.dp-cur-stroke{position:absolute;transform:translate(-50%,-50%);width:0;height:0;border-radius:50%;border:1.5px solid #F4C00C;opacity:0;transition:opacity .2s}
.dp-cur-arrow{position:absolute;transform:translate(-50%,-50%);width:48px;height:48px;border-radius:50%;background:rgba(10,8,2,.88);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity .2s}
.dp-cur-arrow svg{width:18px;height:18px;fill:none;stroke:#fff;stroke-width:2}

#dp-reveal{position:fixed;inset:0;z-index:99999;display:flex;align-items:center;justify-content:center;pointer-events:none}
#dp-reveal-c{width:20px;height:20px;border-radius:50%;background:#0a0802;transform:scale(250);transition:transform 1s cubic-bezier(.3,1,.4,1)}
#dp-pt{position:fixed;inset:0;z-index:99998;pointer-events:none;display:flex;align-items:center;justify-content:center}
#dp-pt-c{width:20px;height:20px;border-radius:50%;background:#0a0802;transform:scale(0);transition:transform .9s cubic-bezier(.7,0,.2,1)}

#dp-nav{position:fixed;top:0;left:0;right:0;height:92px;padding:0 3.4vw;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;z-index:500;background:linear-gradient(to bottom,rgba(10,8,2,.75),transparent)}
.dp-nav-side{display:flex;align-items:center;gap:3vw}
.dp-nav-right{justify-content:flex-end}
.dp-nav-link{color:#F4C00C;text-decoration:none;font-size:13px;letter-spacing:.28em;text-transform:uppercase;white-space:nowrap;position:relative;padding-bottom:3px;font-family:sans-serif}
.dp-nav-link::after{content:'';position:absolute;bottom:0;left:0;width:0;height:1px;background:#F4C00C;transition:width .35s cubic-bezier(.16,1,.3,1)}
.dp-nav-link:hover::after,.dp-nav-link.active::after{width:100%}
.dp-nav-link sup{position:relative;top:-.7em;left:.15em;font-size:9px;color:#fff}
.dp-logo{cursor:pointer}
.dp-logo img{width:56px;height:56px;display:block}

/* HERO */
/* 이미지 로딩 전 엑박 숨기기 */
.dp-float-photo img,
.dp-bphoto img,
.dp-slide-main,
.dp-thumb img{
    opacity:0;
}

/* 이미지가 실제로 로딩된 후 보이기 */
.dp-float-photo img.is-loaded,
.dp-bphoto img.is-loaded,
.dp-slide-main.is-loaded,
.dp-thumb img.is-loaded{
    opacity:1;
}

/* 부드럽게 나타나게 */
.dp-float-photo img,
.dp-bphoto img,
.dp-slide-main,
.dp-thumb img{
    transition:opacity .45s ease;
}



#dp-hero{position:relative;width:100vw;height:160vh;overflow:hidden;background:#111007;display:flex;align-items:center;justify-content:center;margin-left:calc(50% - 50vw)}
.dp-hero-bgtxt{position:absolute;left:-2vw;top:50%;transform:translateY(-50%);font-family:Georgia,serif;font-size:18vw;font-weight:900;color:rgba(0,0,0,.55);white-space:nowrap;pointer-events:none;user-select:none;text-transform:uppercase;letter-spacing:-.02em;z-index:1}
.dp-hero-title{
    position:relative;
