// 모달 닫기
document.querySelectorAll('.dp-modal-close, .dp-modal-ok').forEach(btn=>{
    btn.addEventListener('click', ()=>{
        const modal = document.getElementById('dp-modal');
        if(modal){
            modal.classList.remove('is-show');
            document.body.classList.remove('dp-modal-open');
        }
    });
});

// 배경 클릭 시 닫기
const dpModal = document.getElementById('dp-modal');

if(dpModal){
    dpModal.addEventListener('click', function(e){
        if(e.target === dpModal){
            dpModal.classList.remove('is-show');
            document.body.classList.remove('dp-modal-open');
        }
    });
}


// 연락처 숫자만 입력 + 11자리 제한
const phoneInput = document.querySelector('input[name="phone"]');

if(phoneInput){
    phoneInput.addEventListener('input', function(){
        this.value = this.value.replace(/[^0-9]/g, '').slice(0, 11);
    });
}


