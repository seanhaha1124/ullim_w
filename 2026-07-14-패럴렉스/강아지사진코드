    letter-spacing:.06em;
    text-transform:uppercase;
    font-family: "Gasoek One", sans-serif;
    line-height:1.15;
    max-width:780px;
    padding:0 24px
}

.dp-float-photo{position:absolute;overflow:hidden;pointer-events:none;z-index:3;will-change:transform}
.dp-float-photo img{width:100%;height:100%;object-fit:cover;display:block}
/* 사이즈 */
.dp-fp1{width:clamp(160px,15vw,260px);height:auto;left:2vw;top:55%}
.dp-fp2{width:clamp(140px,13vw,230px);height:auto;left:17vw;top:12%}
.dp-fp3{width:clamp(180px,16vw,280px);height:auto;right:3vw;bottom:22%}
.dp-fp4{width:clamp(140px,13vw,230px);height:auto;right:19vw;top:10%}
.dp-fp5{width:clamp(160px,14vw,250px);height:auto;left:8vw;bottom:10%}
.dp-fp6{width:clamp(130px,12vw,210px);height:auto;right:9vw;top:38%}
.dp-fp7{width:clamp(150px,14vw,240px);height:auto;left:34vw;top:8%}
.dp-fp8{width:clamp(140px,13vw,220px);height:auto;left:44vw;bottom:12%}

/* AUDIO */
#dp-audio{position:fixed;bottom:32px;left:50%;transform:translateX(-50%);z-index:200;display:flex;align-items:center;gap:10px;cursor:pointer}
#dp-audio span{font-size:10px;letter-spacing:4px;text-transform:uppercase;color:#F4C00C;font-family:sans-serif}
#dp-wave{display:flex;align-items:center;gap:2px;height:16px}
#dp-wave .bar{width:2px;height:12px;background:#F4C00C;border-radius:1px;transition:height .1s}

/* 슬라이더 */
#dp-slider{
    position:relative;
    width:100vw;
    height:100vh;
    overflow:hidden;
    background:#0a0802;
    margin-left:calc(50% - 50vw);
}

/* 슬라이드 하나 */
.dp-slide{
    position:absolute;
    inset:0;
    opacity:0;
    transition:opacity .7s ease;
    overflow:hidden;
}

.dp-slide.active{
    opacity:1;
}

/* 흐린 배경 이미지 */
.dp-slide-bg{
    position:absolute;
    inset:-8%;
    z-index:1;
    background-size:cover;
    background-position:center center;
    filter:blur(26px) brightness(.42) contrast(1.08);
    transform:scale(1.08);
    opacity:.9;
}

/* 실제 이미지가 들어가는 안전 영역 */
/* 상단 메뉴와 하단 썸네일에 이미지가 가려지지 않도록 따로 영역을 만듦 */
.dp-slide-inner{
    position:absolute;
    left:0;
    right:0;
    top:92px;
    bottom:90px;
    z-index:2;

    display:flex;
    align-items:center;
    justify-content:center;

    overflow:hidden;
}

/* 실제 큰 이미지 */
/* 기본은 세로 높이에 맞추고, 가로는 원본 비율에 따라 자동 */
.dp-slide-main{
    display:block;
    height:100%;
    width:auto;
    max-width:none;

    object-fit:contain;
    object-position:center center;

    box-shadow:0 30px 90px rgba(0,0,0,.38);
}

/* 가로가 너무 긴 이미지는 화면 밖으로 나가지 않게 자동 보정 */
.dp-slide-main.is-wide{
    width:100vw;
    height:auto;
    max-height:100%;
}

/* 세로가 긴 이미지는 세로 기준으로 맞춤 */
.dp-slide-main.is-tall{
    height:100%;
    width:auto;
    max-width:none;
}

/* 정사각형에 가까운 이미지는 너무 작아 보이지 않게 */
.dp-slide-main.is-square{
    height:100%;
    width:auto;
    max-width:100vw;
}

/* 좌우 클릭 영역 */
.dp-slider-zone{
    position:absolute;
    top:92px;
    bottom:90px;
    width:50%;
    z-index:10;
    cursor:none;
}

#dp-zone-left{
    left:0;
}

#dp-zone-right{
    right:0;
}

/* 썸네일 */
#dp-thumbs{
    position:absolute;
    bottom:0;
    left:0;
    right:0;
    z-index:20;
    height:90px;
    background:rgba(0,0,0,.5);
    overflow:hidden;
}

#dp-thumbs-track{
    display:flex;
    gap:3px;
    height:90px;
    transition:transform .4s cubic-bezier(.16,1,.3,1);
    will-change:transform;
}

.dp-thumb{
    flex:0 0 80px;
    height:90px;
    overflow:hidden;
    cursor:pointer;
    border:2px solid transparent;
    transition:border-color .2s;
}

.dp-thumb.active{
    border-color:#F4C00C;
}

.dp-thumb img{
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center 30%;
    display:block;
    opacity:.7;
    transition:opacity .2s;
}

.dp-thumb.active img,
.dp-thumb:hover img{
    opacity:1;
}

/* 텍스트 */
#dp-text{padding:120px 8vw;background:#111007;width:100%}
.dp-text-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px}
.dp-text-col h2{font-family:Georgia,serif;color:#F4C00C;font-size:clamp(24px,2.2vw,38px);font-weight:400;margin:0 0 28px;line-height:1.2}
.dp-text-col h3{font-family:Georgia,serif;color:#F4C00C;font-size:clamp(18px,1.6vw,28px);font-weight:400;margin:32px 0 14px;line-height:1.2}
.dp-text-col p{color:rgba(255,255,255,.82);font-size:15px;line-height:1.8;margin:0 0 16px;font-family:sans-serif}
.dp-text-col ul{margin:0 0 16px;padding-left:20px}
.dp-text-col ul li{color:rgba(255,255,255,.82);font-size:15px;line-height:1.8;font-family:sans-serif;margin-bottom:6px}
.dp-price-item{margin-bottom:16px}
.dp-price-item strong{color:#fff;font-size:17px}
.dp-price-item span{color:rgba(255,255,255,.7);font-size:15px}

/* 예약 */
