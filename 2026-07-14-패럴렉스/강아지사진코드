}

.dp-privacy-text p{
    margin:0 0 6px;
}


/* 문의 완료 모달 */
.dp-modal{
    position:fixed;
    inset:0;
    z-index:1000000;
    display:none;
    align-items:center;
    justify-content:center;
    background:rgba(0,0,0,.72);
    backdrop-filter:blur(8px);
}

.dp-modal.is-show{
    display:flex;
}

.dp-modal-box{
    position:relative;
    width:min(420px, calc(100% - 40px));
    padding:44px 34px 36px;
    background:#111007;
    border:1px solid rgba(244,192,12,.45);
    box-shadow:0 30px 80px rgba(0,0,0,.45);
    text-align:center;
    font-family:'Noto Sans KR', sans-serif;
    transform:translateY(20px) scale(.96);
    opacity:0;
    animation:dpModalIn .45s cubic-bezier(.16,1,.3,1) forwards;
}

@keyframes dpModalIn{
    to{
        transform:translateY(0) scale(1);
        opacity:1;
    }
}

.dp-modal-small{
    margin:0 0 12px;
    color:#F4C00C;
    font-size:11px;
    letter-spacing:.28em;
    text-transform:uppercase;
}

.dp-modal-box h3{
    margin:0 0 16px;
    color:#F4C00C;
    font-size:28px;
    font-weight:400;
    line-height:1.25;
    font-family:'Noto Sans KR', sans-serif;
}

.dp-modal-box p{
    margin:0 0 24px;
    color:rgba(255,255,255,.78);
    font-size:14px;
    line-height:1.7;
}

.dp-modal-ok{
    border:1px solid #F4C00C;
    background:transparent;
    color:#F4C00C;
    padding:12px 28px;
    font-size:11px;
    letter-spacing:.22em;
    text-transform:uppercase;
    cursor:pointer;
    transition:background .25s ease, color .25s ease;
}

.dp-modal-ok:hover{
    background:#F4C00C;
    color:#111007;
}

.dp-modal-close{
    position:absolute;
    right:16px;
    top:12px;
    width:32px;
    height:32px;
    border:0;
    background:transparent;
    color:#F4C00C;
    font-size:28px;
    line-height:1;
    cursor:pointer;
}



/* 모달이 열렸을 때는 기본 마우스 커서 보이게 */
body.dp-modal-open,
body.dp-modal-open *{
    cursor:auto !important;
}

/* 모달이 열렸을 때 커스텀 커서는 숨김 */
body.dp-modal-open #dp-cursor{
    display:none !important;
}

body.dp-modal-open .dp-modal-close,
body.dp-modal-open .dp-modal-ok{
    cursor:pointer !important;
}



