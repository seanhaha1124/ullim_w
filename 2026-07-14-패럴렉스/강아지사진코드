});

// 커서
const cursor=document.getElementById('dp-cursor');
const dot=document.getElementById('dp-dot');
const stroke=document.getElementById('dp-stroke');
const arrow=document.getElementById('dp-arrow');
const arrowPoly=document.getElementById('dp-arrow-poly');
document.addEventListener('mousemove',e=>{
    cursor.style.transform=`translate(${e.clientX}px,${e.clientY}px)`;
});
function setCursor(mode){
    dot.style.opacity=mode==='dot'?'1':'0';
    stroke.style.opacity=mode==='link'?'1':'0';
    arrow.style.opacity=mode==='arrow'?'1':'0';
    if(mode==='link'){
        stroke.style.width='0';stroke.style.height='0';
        requestAnimationFrame(()=>requestAnimationFrame(()=>{
            stroke.style.transition='width .25s cubic-bezier(.16,1,.3,1),height .25s cubic-bezier(.16,1,.3,1),opacity .2s';
            stroke.style.width='40px';stroke.style.height='40px';
        }));
    }
}
setCursor('dot');
document.querySelectorAll('.dp-nav-link,.dp-logo,#dp-audio').forEach(el=>{
    el.addEventListener('mouseenter',()=>setCursor('link'));
    el.addEventListener('mouseleave',()=>setCursor('dot'));
});



function setImageLoaded(img, url, alt){
    if(!img || !url)return;

    img.classList.remove('is-loaded');

    img.onload=function(){
        img.classList.add('is-loaded');
    };

    img.onerror=function(){
        img.classList.remove('is-loaded');
        img.removeAttribute('src');
    };

    img.alt = alt || '';
    img.src = url;

    if(img.complete && img.naturalWidth > 0){
        img.classList.add('is-loaded');
    }
}

// REST API
let allPhotos=[];
fetch(`${SITE_URL}/wp-json/wp/v2/${POST_TYPE}?per_page=30&_embed=1`)
    .then(r=>r.ok?r.json():[])
    .then(posts=>{
        allPhotos=posts.map(p=>{
            try{
                const m=p._embedded['wp:featuredmedia'];
                if(m&&m[0])return{url:m[0].source_url,alt:p.title.rendered};
            }catch(e){}
            return null;
        }).filter(Boolean);
        buildHero();
        buildSlider();
        buildBookingPhotos();
